{
  "manifest_version": 2,
  "name": "Conduit Communicator",
  "version": "0.1.0",
  "description": "A sidebar-first communications hub for mail, calendar, tasks, feeds, and chats.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "page": "background.html"
  },
  "browser_action": {
    "default_title": "Conduit Communicator",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "sidebar_action": {
    "default_title": "Conduit Communicator",
    "default_panel": "sidebar/sidebar.html",
    "open_at_install": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "conduit-communicator@alfonsojon.com",
      "strict_min_version": "151.0"
    }
  }
}
